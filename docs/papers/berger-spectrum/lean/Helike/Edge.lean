  -884695684349952*s^8 - 10642928959488*s^7*x^7 + 36675262611456*s^7*x^5*y^2 + 260912820781056*s^7*x^5 - 26561419935744*s^7*x^3*y^4 - 406796351045632*s^7*x^3*y^2 - 1721418060398592*s^7*x^3 + 3542140059648*s^7*x*y^6 + 82491289370624*s^7*x*y^4 + 721768717221888*s^7*x*y^2 + 2367600721920000*s^7*x - 43632572760064*s^6*x^6 + 92802432106496*s^6*x^4*y^2 + 726234946338816*s^6*x^4 - 36072423686144*s^6*x^2*y^4 - 575319727669248*s^6*x^2*y^2 - 2569518408794112*s^6*x^2 + 1437538975744*s^6*y^6 + 34218675535872*s^6*y^4 + 304422718537728*s^6*y^2 + 1009018277462016*s^6 - 127715147513856*s^5*x^5 + 160342940319744*s^5*x^3*y^2 + 1319323759017984*s^5*x^3 - 28154315931648*s^5*x*y^4 - 457724865282048*s^5*x*y^2 - 2086948231446528*s^5*x - 264978007326720*s^4*x^4 + 179802363396096*s^4*x^2*y^2 + 1514027511447552*s^4*x^2 - 9579119247360*s^4*y^4 - 156696513085440*s^4*y^2 - 716397323747328*s^4 - 380362303733760*s^3*x^3 + 117703578746880*s^3*x*y^2 + 997755262599168*s^3*x - 359024906207232*s^2*x^2 + 34093450395648*s^2*y^2 + 288054866608128*s^2 - 200385994162176*s*x - 50096498540544

/-- The numerator of det(B₄,₀ − λ₄ I), as computed (473 terms, entered in ten parts). -/
def edgeDet (x y s : ℝ) : ℝ :=
  edgeDetPart1 x y s + edgeDetPart2 x y s + edgeDetPart3 x y s + edgeDetPart4 x y s + edgeDetPart5 x y s + edgeDetPart6 x y s + edgeDetPart7 x y s + edgeDetPart8 x y s + edgeDetPart9 x y s + edgeDetPart10 x y s

/-- The first factor (degrees 5, 6, 12 in x, y, s). -/
def edgeP1 (x y s : ℝ) : ℝ :=
  2*s^12*x^2 - 5*s^11*x^3 - 3*s^11*x*y^2 - 24*s^11*x - s^10*x^4 + 12*s^10*x^2*y^2 + 128*s^10*x^2 + s^10*y^4 + 12*s^10*y^2 + s^9*x^5 + 3*s^9*x^3*y^2 - 106*s^9*x^3 - 8*s^9*x*y^4 - 66*s^9*x*y^2 - 572*s^9*x - 4*s^8*x^4*y^2 + 2*s^8*x^4 + s^8*x^2*y^4 + 122*s^8*x^2*y^2 + 1052*s^8*x^2 + s^8*y^6 + 20*s^8*y^4 + 220*s^8*y^2 + 960*s^8 + 12*s^7*x^5 + 3*s^7*x^3*y^4 - 20*s^7*x^3*y^2 - 744*s^7*x^3 - 3*s^7*x*y^6 - 60*s^7*x*y^4 - 316*s^7*x*y^2 - 600*s^7*x - 20*s^6*x^4*y^2 + 136*s^6*x^4 + 46*s^6*x^2*y^4 + 520*s^6*x^2*y^2 + 624*s^6*x^2 - 6*s^6*y^6 - 172*s^6*y^4 - 1672*s^6*y^2 - 7776*s^6 + 32*s^5*x^5 - 288*s^5*x^3*y^2 - 1248*s^5*x^3 + 196*s^5*x*y^4 + 3088*s^5*x*y^2 + 14736*s^5*x + 576*s^4*x^4 - 1568*s^4*x^2*y^2 - 12096*s^4*x^2 + 232*s^4*y^4 + 4000*s^4*y^2 + 21024*s^4 + 3840*s^3*x^3 - 3456*s^3*x*y^2 - 30016*s^3*x + 11776*s^2*x^2 - 2624*s^2*y^2 - 23424*s^2 + 16896*s*x + 9216

/-- The edge factor (degrees 7, 8, 16 in x, y, s): it vanishes on the edge wherever B₄,₀ is the competitor. -/
def edgeP2 (x y s : ℝ) : ℝ :=
  -8*s^16*x^2 + 24*s^15*x^3 + 8*s^15*x*y^2 - 4*s^14*x^4 - 42*s^14*x^2*y^2 - 320*s^14*x^2 - 2*s^14*y^4 - 11*s^13*x^5 + 2*s^13*x^3*y^2 + 704*s^13*x^3 + 25*s^13*x*y^4 + 416*s^13*x*y^2 + 752*s^13*x + s^12*x^6 + 41*s^12*x^4*y^2 - 128*s^12*x^4 - 29*s^12*x^2*y^4 - 1376*s^12*x^2*y^2 - 5376*s^12*x^2 - 5*s^12*y^6 - 128*s^12*y^4 - 376*s^12*y^2 + s^11*x^7 - 2*s^11*x^5*y^2 - 186*s^11*x^5 - 27*s^11*x^3*y^4 + 200*s^11*x^3*y^2 + 7256*s^11*x^3 + 28*s^11*x*y^6 + 1026*s^11*x*y^4 + 7688*s^11*x*y^2 + 11424*s^11*x - 6*s^10*x^6*y^2 + 38*s^10*x^6 + 3*s^10*x^4*y^4 + 524*s^10*x^4*y^2 - 2336*s^10*x^4 + 6*s^10*x^2*y^6 - 482*s^10*x^2*y^4 - 11720*s^10*x^2*y^2 - 23328*s^10*x^2 - 3*s^10*y^8 - 16*s^10*y^6 + 360*s^10*y^4 + 1504*s^10*y^2 - 17280*s^10 + 12*s^9*x^7 + 9*s^9*x^5*y^4 - 128*s^9*x^5*y^2 - 828*s^9*x^5 - 18*s^9*x^3*y^6 - 224*s^9*x^3*y^4 + 5408*s^9*x^3*y^2 + 29232*s^9*x^3 + 9*s^9*x*y^8 + 100*s^9*x*y^6 - 708*s^9*x*y^4 - 21152*s^9*x*y^2 - 27696*s^9*x - 36*s^8*x^6*y^2 + 344*s^8*x^6 + 186*s^8*x^4*y^4 + 616*s^8*x^4*y^2 - 16296*s^8*x^4 - 168*s^8*x^2*y^6 - 1880*s^8*x^2*y^4 + 5120*s^8*x^2*y^2 + 67344*s^8*x^2 + 18*s^8*y^8 + 368*s^8*y^6 + 5224*s^8*y^4 + 39824*s^8*y^2 + 183168*s^8 + 32*s^7*x^7 - 816*s^7*x^5*y^2 + 1200*s^7*x^5 + 1768*s^7*x^3*y^4 + 15616*s^7*x^3*y^2 - 14160*s^7*x^3 - 744*s^7*x*y^6 - 10944*s^7*x*y^4 - 87648*s^7*x*y^2 - 343328*s^7*x + 960*s^6*x^6 - 7920*s^6*x^4*y^2 - 28320*s^6*x^4 + 8400*s^6*x^2*y^4 + 103392*s^6*x^2*y^2 + 403488*s^6*x^2 - 960*s^6*y^6 - 18512*s^6*y^4 - 176320*s^6*y^2 - 715392*s^6 + 11904*s^5*x^5 - 42624*s^5*x^3*y^2 - 288704*s^5*x^3 + 19920*s^5*x*y^4 + 279552*s^5*x*y^2 + 1388736*s^5*x + 78592*s^4*x^4 - 131520*s^4*x^2*y^2 - 1067904*s^4*x^2 + 17696*s^4*y^4 + 256896*s^4*y^2 + 1282176*s^4 + 296448*s^3*x^3 - 209664*s^3*x*y^2 - 1748736*s^3*x + 635904*s^2*x^2 - 131328*s^2*y^2 - 1064448*s^2 + 718848*s*x + 331776

/-- The degree-16 polynomial in s = √t whose root is the Floor paper's threshold t_A. -/
def tAPoly (s : ℝ) : ℝ :=
  3*s^16 + 121*s^14 + 1066*s^12 - 2836*s^10 - 18624*s^8 + 20992*s^6 + 181248*s^4 - 425984*s^2 + 262144

/-- **The factorization.** The determinant numerator splits exactly as −16384 · P₁ · P₂. -/
theorem edgeDet_factor (x y s : ℝ) : edgeDet x y s = -16384 * edgeP1 x y s * edgeP2 x y s := by
  unfold edgeDet edgeDetPart1 edgeDetPart2 edgeDetPart3 edgeDetPart4 edgeDetPart5 edgeDetPart6 edgeDetPart7 edgeDetPart8 edgeDetPart9 edgeDetPart10 edgeP1 edgeP2
  ring

/-- **On the Berger path the edge factor is the t_A polynomial** (times −32 (s−1)(s+1)). -/
theorem edgeFactor_berger {s : ℝ} (hs : s ≠ 0) :
    edgeP2 ((2 - s ^ 2) / s) s s = -32 * (s - 1) * (s + 1) * tAPoly s := by
  unfold edgeP2 tAPoly
  field_simp
  ring

/-- **t_A exists where the paper says**: Q₁₆ changes sign on [1.65261, 1.65262]. -/
theorem tA_poly_root : ∃ s ∈ Set.Icc (165261 / 100000 : ℝ) (165262 / 100000), tAPoly s = 0 := by
  have hcont : ContinuousOn tAPoly (Set.Icc (165261 / 100000 : ℝ) (165262 / 100000)) := by
    unfold tAPoly
    fun_prop
  have ha : tAPoly (165261 / 100000) < 0 := by norm_num [tAPoly]
  have hb : 0 < tAPoly (165262 / 100000) := by norm_num [tAPoly]
  have hivt := intermediate_value_Icc (by norm_num : (165261 / 100000 : ℝ) ≤ 165262 / 100000) hcont
  obtain ⟨c, hc, hfc⟩ := hivt ⟨ha.le, hb.le⟩
  exact ⟨c, hc, hfc⟩

/-- **The Berger path meets the edge polynomial at t_A**: at that root, P₂ vanishes on the Berger path, and
t = s² lies in [2.73111, 2.73116]. -/
theorem berger_crosses_edge :
    ∃ s : ℝ, 165261 / 100000 ≤ s ∧ s ≤ 165262 / 100000 ∧
      edgeP2 ((2 - s ^ 2) / s) s s = 0 ∧ 273111 / 100000 ≤ s ^ 2 ∧ s ^ 2 ≤ 273116 / 100000 := by
  obtain ⟨s, ⟨h1, h2⟩, hroot⟩ := tA_poly_root
  have hs : s ≠ 0 := by
    intro h; rw [h] at h1; norm_num at h1
  refine ⟨s, h1, h2, ?_, ?_, ?_⟩
  · rw [edgeFactor_berger hs, hroot]; ring
  · nlinarith
  · nlinarith

end Helike
